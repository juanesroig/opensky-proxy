# HTTP port the Express server listens on (required).
PORT=5000

# Comma-separated list of allowed browser origins (required).
# Local dev example: http://localhost:5173
# Production example: https://your-frontend.example.com
CORS_ORIGIN=http://localhost:5173

# OpenSky OAuth client credentials (required).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
