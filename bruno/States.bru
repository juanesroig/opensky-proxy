meta {
  name: States
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/opensky/states
  body: none
  auth: none
}

headers {
  Accept: text/event-stream
}

docs {
  Server-Sent Events stream of all OpenSky aircraft states.

  The connection stays open and the proxy pushes a new `data` event on
  every poll interval. An initial `connected` event is sent on connect.
}
